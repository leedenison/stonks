{
  "openfigi.vcr": {
    "upstream": "https://api.openfigi.com",
    "recorded": "openfigi/recorded.yaml",
    "authored": "openfigi/authored.yaml",
    "interval": "240ms",
    "credential": { "in": "header", "name": "X-OPENFIGI-APIKEY", "env": "OPENFIGI_API_KEY" }
  },
  "massive.vcr": {
    "upstream": "https://api.massive.com",
    "recorded": "massive/recorded.yaml",
    "interval": "12s",
    "credential": { "in": "query", "name": "apiKey", "env": "MASSIVE_API_KEY" },
    "redact": ["address", "phone_number", "description"]
  },
  "eodhd.vcr": {
    "upstream": "https://eodhd.com",
    "recorded": "eodhd/recorded.yaml",
    "authored": "eodhd/authored.yaml",
    "interval": "60ms",
    "credential": { "in": "query", "name": "api_token", "env": "EODHD_API_KEY" }
  }
}
