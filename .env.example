# OAuth client id for Sign in with Google. Required for make run.
GOOGLE_OAUTH_CLIENT_ID=

# Comma-separated glob patterns an email must match for an account to be
# created on first sign-in. Empty creates no accounts.
#STONKS_ALLOWED_EMAILS=*@example.com

# Server log level: debug, info, warn or error, optionally followed by overrides
# for log categories, which are package paths below server/. The dev stack
# defaults to debug.
#STONKS_LOG_LEVEL=info,internal/db=debug

# SQL applied to the dev database after make run brings the stack up.
# local/ is gitignored and is where such a file belongs.
#DEV_SEED_SQL=local/seed.sql

# Deployment this process belongs to, reported on every trace and metric.
#STONKS_ENVIRONMENT=development

# Grafana sign-in for the dev stack. The password cannot be "admin", which
# Grafana treats as unset and prompts to change at first login.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=stonks
